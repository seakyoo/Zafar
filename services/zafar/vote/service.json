{
  "$schema": "https://flisk.sh/schema.service.json",
  "schemaVersion": 1,
  "appName": "vote",
  "appType": "bring-your-own",
  "stack": "zafar",
  "port": 80,
  "healthCheckPath": "/",
  "healthCheck": {
    "command": [
      "curl",
      "-f",
      "http://localhost"
    ],
    "interval": 15,
    "timeout": 5,
    "retries": 3,
    "startPeriod": 10
  },
  "buildContext": "../../../vote",
  "dockerfile": "Dockerfile",
  "dependsOn": [
    {
      "name": "redis",
      "condition": "service_healthy"
    }
  ],
  "extraPorts": [
    {
      "port": 80,
      "publish": "8080"
    }
  ],
  "volumes": [
    {
      "source": "../../../vote",
      "target": "/usr/local/app"
    }
  ]
}
