{
  "$schema": "https://flisk.sh/schema.service.json",
  "schemaVersion": 1,
  "appName": "redis",
  "appType": "bring-your-own",
  "stack": "zafar",
  "port": 4001,
  "healthCheck": {
    "command": [
      "sh",
      "-c",
      "/healthchecks/redis.sh"
    ],
    "interval": 5
  },
  "image": "redis:alpine",
  "exposeViaProxy": false,
  "volumes": [
    {
      "source": "../../../healthchecks",
      "target": "/healthchecks"
    }
  ]
}
